<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"


    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"

        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="match_parent"
                android:background="@drawable/home"
                android:contentDescription="TODO" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingLeft="4dp"
                android:paddingTop="24dp"
                android:shadowColor="#0B0A0A"
                android:text="For CSE"
                android:textColor="@color/black"
                android:textColorHighlight="#E4A2A2"
                android:textSize="24sp" />
        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView

        android:layout_width="match_parent"
        android:layout_height="689dp"

        android:padding="20dp"
        app:layout_anchorGravity="center"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/linearLayout3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <Button
                    android:id="@+id/button3"
                    android:layout_width="24dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:background="@drawable/button"
                    android:onClick="cources_CSE"
                    android:text="Explore Courses"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/button4"
                    android:layout_width="24dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:background="@drawable/button"
                    android:onClick="cources_AI"
                    android:text="Practice courses" />
            </LinearLayout>

            <!-- GridView to display subjects -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Courses"
                android:textColor="@color/black"
                android:textSize="28dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout3"
                app:layout_constraintVertical_bias="0.815" />

            <HorizontalScrollView
                android:id="@+id/horizontalScrollView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout3"
                app:layout_constraintVertical_bias="0.199">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_courses"
                        android:layout_width="127dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/button"
                        android:text="Courses"
                        android:textColor="@color/gray" />

                    <Button
                        android:id="@+id/btn_main_subject"
                        android:layout_width="127dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/button"
                        android:text="Main Subject"
                        android:textColor="@color/gray" />

                    <Button
                        android:id="@+id/btn_revision"
                        android:layout_width="127dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/button"
                        android:text="Revision"
                        android:textColor="@color/gray" />

                    <Button
                        android:id="@+id/btn_mock_test"
                        android:layout_width="127dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/button"
                        android:text="Mock Test"
                        android:textColor="@color/gray" />
                </LinearLayout>
            </HorizontalScrollView>

            <GridView
                android:id="@+id/grid_view"
                android:layout_width="match_parent"
                android:layout_height="408dp"
                android:layout_below="@+id/horizontalScrollView2"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="4dp"
                android:horizontalSpacing="10dp"
                android:numColumns="3"
                android:padding="10dp"
                android:verticalSpacing="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView2"
                tools:ignore="UnknownId" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>


</androidx.coordinatorlayout.widget.CoordinatorLayout>