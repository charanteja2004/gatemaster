# Build output
build/
*/build/
.gradle/
.cxx/
.externalNativeBuild/
captures/
*.apk
*.aab
*.ap_
*.dex
*.class
local.properties
build.log

# Bundled PDFs are not kept in the repository: they are large, and they are
# third-party documents we redistribute in the APK but should not republish as
# source. Keep them locally; the app indexes whatever is present at build time.
app/src/main/assets/pdfs/
app/src/main/assets/previousPapers/
legacy/src/main/assets/pdfs/
legacy/src/main/assets/previousPapers/

# Signing material — never commit these
*.jks
*.keystore
keystore.properties
signing.properties

# Android Studio / IntelliJ
*.iml
.idea/*
!.idea/codeStyles/
!.idea/inspectionProfiles/

# OS
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/

# Python tooling
__pycache__/
*.pyc
