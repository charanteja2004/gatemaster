<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The only XML theme in the app. Everything after the splash is Compose
      Material 3; this exists so the window has a background and the splash has
      somewhere to hang off.

      The splash keeps one deep navy in both light and dark: it is the app's
      identity, and a splash that flips colour with the system reads as two
      different apps rather than one.
    -->
    <style name="Theme.GateMaster.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_gate_logo</item>
        <item name="windowSplashScreenAnimationDuration">950</item>
        <item name="postSplashScreenTheme">@style/Theme.GateMaster.Main</item>
    </style>

    <style name="Theme.GateMaster.Main" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
